<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IncubadoraApp.Views.LoginView"
             x:CompileBindings="False"
             Background="#0F172A">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        
        <!-- Usado Border em vez de Grid para aceitar a propriedade Padding -->
        <Border Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <WrapPanel HorizontalAlignment="Center" 
                       VerticalAlignment="Center">

                <!-- 1. IMAGEM E TÍTULO (FORA DA CAIXA) -->
                <StackPanel Width="320" 
                            Margin="16" 
                            Spacing="12" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                    
                    <Image Source="avares://IncubadoraApp/Assets/logo123.jpg"
                           Stretch="Uniform"
                           MaxHeight="180"
                           MaxWidth="220"
                           HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="SIIA" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Sistema Inteligente de Incubadora para Avicultores" 
                               FontSize="13" 
                               Foreground="#94A3B8" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 2. CAIXA BRANCA DE LOGIN -->
                <Border Background="White"
                        CornerRadius="16"
                        Padding="24"
                        Width="320"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BoxShadow="0 10 30 0 #40000000">
                    
                    <StackPanel Spacing="14">
                        
                        <StackPanel Spacing="2">
                            <TextBlock Text="Iniciar Sessão" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#0F172A"/>
                            
                            <TextBlock Text="Introduza os seus dados de acesso" 
                                       FontSize="12" 
                                       Foreground="#64748B"/>
                        </StackPanel>

                        <!-- Mensagem de Erro -->
                        <TextBlock x:Name="LblErro"
                                   Foreground="#DC2626"
                                   FontSize="12"
                                   IsVisible="False"
                                   TextWrapping="Wrap"/>

                        <!-- Campo Utilizador/Email -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="Utilizador ou Email" 
                                       FontSize="12" 
                                       Foreground="#334155" 
                                       FontWeight="SemiBold"/>
                            
                            <TextBox x:Name="TxtUsuario"
                                     Watermark="Ex: manuel.silva"
                                     Padding="10"
                                     CornerRadius="6"/>
                        </StackPanel>

                        <!-- Campo Palavra-passe -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="Palavra-passe" 
                                       FontSize="12" 
                                       Foreground="#334155" 
                                       FontWeight="SemiBold"/>
                            
                            <TextBox x:Name="TxtSenha"
                                     Watermark="••••••••"
                                     Padding="10"
                                     CornerRadius="6"/>
                        </StackPanel>

                        <!-- Botão de Entrar -->
                        <Button x:Name="BtnEntrar"
                                Content="Entrar no Sistema"
                                Click="OnBtnEntrarClicked"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12"
                                Margin="0,6,0,0"
                                CornerRadius="6"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Border>
    </ScrollViewer>
</UserControl>